# PNCP Scanner - Environment Variables

# API Configuration
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao
API_TIMEOUT=15
PAGE_SIZE=50
MAX_PAGES=10
REQUEST_DELAY=0.05

# Geocoding (optional)
GEOLOCATOR_USER_AGENT=pncp_scanner_v1
GEOCODE_TIMEOUT=2

# App
APP_NAME=PNCP Scanner
APP_VERSION=1.0.0
DEBUG=false
